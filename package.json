{
	"name": "chiselcode-desktop",
	"version": "0.1.0-beta.4",
	"description": "ChiselCode Desktop — графический клиент общего ядра ChiselCode",
	"private": true,
	"type": "module",
	"main": "dist/main/index.js",
	"author": "TheAsrada",
	"license": "MIT",
	"homepage": "https://github.com/TheAsrada/ChiselCodeDesktop",
	"scripts": {
		"sync:engine": "node scripts/sync-engine.mjs",
		"dev": "node scripts/dev.mjs",
		"build": "tsc --noEmit && vite build && esbuild src/main/index.ts src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --external:electron-updater --outdir=dist/main --out-extension:.js=.cjs && node scripts/finish-build.mjs",
		"typecheck": "tsc --noEmit",
		"test": "node --test tests/*.test.mjs",
		"test:e2e": "playwright test",
		"package": "npm run build && electron-builder --publish never",
		"package:dir": "npm run build && electron-builder --dir --publish never",
		"verify": "npm run typecheck && npm test && npm run build",
		"update:engine": "node scripts/update-engine.mjs",
		"icon": "node scripts/icon.mjs",
		"test:installers": "node scripts/verify-installers.mjs"
	},
	"dependencies": {
		"@chiselcode/desktop-sdk": "file:vendor/desktop-sdk",
		"@fontsource-variable/manrope": "5.3.0",
		"@fontsource/jetbrains-mono": "5.3.0",
		"electron-updater": "6.8.9",
		"lucide-react": "1.56.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1"
	},
	"devDependencies": {
		"@playwright/test": "1.64.0",
		"@types/node": "24.10.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"electron": "44.7.0",
		"electron-builder": "26.15.3",
		"esbuild": "0.28.2",
		"fflate": "0.8.2",
		"sharp": "0.34.5",
		"typescript": "7.0.2",
		"vite": "8.3.4"
	},
	"build": {
		"appId": "com.chiselcode.desktop",
		"productName": "ChiselCode Desktop",
		"artifactName": "ChiselCodeDesktop-${version}-${os}-${arch}.${ext}",
		"directories": {
			"output": "release",
			"buildResources": "assets"
		},
		"files": [
			"dist/**/*",
			"package.json",
			"assets/icon.png"
		],
		"asar": true,
		"extraResources": [
			{
				"from": "vendor/engine",
				"to": "engine"
			}
		],
		"publish": {
			"provider": "github",
			"owner": "TheAsrada",
			"repo": "ChiselCodeDesktop",
			"releaseType": "prerelease"
		},
		"win": {
			"target": [
				"nsis"
			],
			"icon": "assets/icon.png",
			"signAndEditExecutable": false
		},
		"nsis": {
			"oneClick": false,
			"perMachine": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"deleteAppDataOnUninstall": false
		},
		"mac": {
			"target": [
				"dmg",
				"zip"
			],
			"icon": "assets/icon.png",
			"category": "public.app-category.developer-tools",
			"identity": "-"
		},
		"linux": {
			"target": [
				"AppImage",
				"deb"
			],
			"icon": "assets/icon.png",
			"category": "Development",
			"maintainer": "TheAsrada",
			"desktop": {
				"entry": {
					"StartupWMClass": "chiselcode-desktop",
					"Name": "ChiselCode Desktop"
				}
			},
			"syncDesktopName": true
		}
	},
	"desktopName": "chiselcode-desktop.desktop"
}
